# ==============================================================================
# Telugu AI Voice Calling SaaS Platform — Environment Configuration Template
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string-please
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# Public tunnel (required for inbound PSTN audio)
# ==============================================================================
# VoBiz/Twilio must be able to reach this server over the internet. A carrier
# cannot reach a localhost URL, so without a working tunnel inbound calls
# connect but carry NO audio.
#
# TUNNEL_MODE:
#   ngrok  - launch ngrok (server/bin/ngrok.exe). Immune to the Cloudflare
#           per-IP quota, so it is the quickest way out of an HTTP 429. Needs a
#           free authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
#           Downside: the free tier assigns a RANDOM *.ngrok-free.dev subdomain
#           that changes on every restart, so a static answer_url set in the
#           VoBiz console goes stale (outbound calls still work, because this
#           app resolves answer_url fresh at dial time).
#   quick  (default) - account-less trycloudflare.com tunnel. Free, zero setup,
#                      but Cloudflare caps these per IP (~200/day) and answers
#                      HTTP 429 / error 1015 once you exceed it. The limit lifts
#                      on a daily quota window, NOT on a short timer, so it can
#                      block you for hours. Fine for a smoke test only.
#   named            - a Cloudflare named tunnel using an account token. No rate
#                      limits, a STABLE hostname, survives restarts. Use this for
#                      anything long-running. One-time setup, free:
#                        cloudflared tunnel login
#                        cloudflared tunnel create ai-calling
#                        cloudflared tunnel route dns ai-calling <your-domain>
#                      then copy the token from the dashboard into the var below.
#   off              - an external tunnel (ngrok / reverse proxy) is already
#                      serving this app; set PUBLIC_WEBHOOK_URL to its address.
TUNNEL_MODE=quick

# ngrok (used when TUNNEL_MODE=ngrok). Free token, no card required.
NGROK_AUTHTOKEN=
# Only on a paid plan: pin a stable subdomain instead of a random one.
NGROK_DOMAIN=
# Overrides the ngrok binary location (default: server/bin/ngrok.exe)
NGROK_PATH=

# Named-tunnel credentials (used when TUNNEL_MODE=named). Prefer TOKEN_FILE so the
# secret does not appear in the process list.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN_FILE=
# The hostname you routed to the tunnel, e.g. calls.yourdomain.com
CLOUDFLARE_TUNNEL_HOSTNAME=

# Overrides the cloudflared binary location (default: server/bin/cloudflared.exe)
CLOUDFLARED_PATH=

# When set, this is used instead of launching a tunnel. Must be reachable.
# PUBLIC_WEBHOOK_URL=https://calls.yourdomain.com

# Set to true ONLY for local carrier mocks. With no public URL, real calls dial a
# localhost answer_url: the callee hears silence and you are still billed.
ALLOW_LOCAL_ANSWER_URL=false

# MySQL Database (XAMPP / Remote)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_calling_platform

# MOCK_MODE: Set to "false" to use real live APIs (VoBiz, Sarvam, Cartesia, LLM, etc.)
MOCK_MODE=true

# Redis Queue (BullMQ for bulk campaigns, e.g. redis://localhost:6379)
REDIS_URL=

# Telephony: VoBiz (https://vobiz.ai/docs)
# Base URL must include the /api/v1 version prefix.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_BASE_URL=https://api.vobiz.ai/api/v1
# Console credentials are NOT used by the REST API. Never commit them.
VOBIZ_CONSOLE_EMAIL=
VOBIZ_CONSOLE_PASSWORD=
# When true, a callback carrying an invalid or replayed X-Vobiz-Signature-V* is
# rejected with 401 instead of being logged and accepted. Leave false while
# signature auth is not yet configured on the callback URLs in the VoBiz
# console, because the headers are absent until it is.
VOBIZ_REQUIRE_SIGNATURE=false

# Sarvam AI: Telugu voice TTS & STT (https://sarvam.ai)
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v1
SARVAM_STT_MODEL=saarika:v2

# Cartesia Voice (https://docs.cartesia.ai)
# REST auth is "Authorization: Bearer <key>"; X-API-Key is used only for the
# WebSocket handshake, which this server does itself.
CARTESIA_API_KEY=
# Must be one of: sonic-3.6 | sonic-3.5 | sonic-3 | sonic-latest
CARTESIA_MODEL=sonic-3.6
CARTESIA_VOICE_ID=

# Groq LLM (https://console.groq.com/docs)
# Chat, Whisper STT and Orpheus TTS all live on the same host and key.
GROQ_API_KEY=
# Must be a documented model id; defaults to qwen/qwen3.8-27b.
# Note: every multilingual chat model Groq publishes is PREVIEW tier, which the
# docs say should not be used in production as models may be withdrawn at short
# notice. Always set a Production fallback.
GROQ_MODEL=qwen/qwen3.8-27b
# Retried once if the primary model is rejected (unknown / deprecated / 400).
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Orpheus covers English and Arabic only and needs terms acceptance on the
# account; Telugu calls use Cartesia.
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Campaigns: dial each batch with one documented bulk request instead of
# looping per lead. Set to false to force the one-call-per-request path.
CAMPAIGN_BULK_DIAL=true

# LLM (OpenAI / Groq / OpenRouter / DeepSeek)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.6

# Payments & Billing (mock | razorpay | stripe)
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Telugu AI Calling <no-reply@example.com>"
# Outpero (AI calling backend)
OUTPERO_API_KEY=
OUTPERO_BASE_URL=https://api.outpero.com/v1
